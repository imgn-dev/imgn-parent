<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">

  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>be.imgn.parent</groupId>
    <artifactId>parent</artifactId>
    <version>@project.version@</version>
    <relativePath/>
  </parent>

  <artifactId>managed-library-versions</artifactId>
  <version>1.0.0</version>

  <name>managed-library-versions</name>

  <!-- The catalogue is opt-in: inheriting the parent brings the build gates,
       this <import> brings the library versions. -->
  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>be.imgn.parent</groupId>
        <artifactId>bom</artifactId>
        <version>@project.version@</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <!-- Not one <version> anywhere below. Every one comes from the imported BOM;
       if an entry is dropped, this project stops resolving. -->
  <dependencies>
    <dependency>
      <groupId>tools.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
    </dependency>
    <dependency>
      <groupId>org.jdbi</groupId>
      <artifactId>jdbi3-core</artifactId>
    </dependency>
    <dependency>
      <groupId>org.antlr</groupId>
      <artifactId>antlr4-runtime</artifactId>
    </dependency>
    <dependency>
      <groupId>dev.dirs</groupId>
      <artifactId>directories</artifactId>
    </dependency>
    <dependency>
      <groupId>com.palantir.javapoet</groupId>
      <artifactId>javapoet</artifactId>
    </dependency>
    <dependency>
      <groupId>com.h2database</groupId>
      <artifactId>h2</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.mockito</groupId>
      <artifactId>mockito-core</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.assertj</groupId>
      <artifactId>assertj-core</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <!-- The Mockito agent recipe from the README, exercised for real. Without it
       the JDK prints "Mockito is currently self-attaching to enable the
       inline-mock-maker. This will no longer work in future releases of the
       JDK." dependency:properties defines ${org.mockito:mockito-core:jar};
       surefire resolves it late, at fork time.

       Deliberately NOT @{argLine}: this project has no JaCoCo, and surefire
       passes an unresolved @{argLine} to the JVM verbatim, which dies with
       "Error: could not open '{argLine}'". A module WITH JaCoCo must write
       @{argLine} first or it silently loses coverage. -->
  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-dependency-plugin</artifactId>
        <executions>
          <execution>
            <id>mockito-agent-path</id>
            <goals>
              <goal>properties</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <argLine>-javaagent:${org.mockito:mockito-core:jar}</argLine>
        </configuration>
      </plugin>
    </plugins>
  </build>

</project>
